# MongoDB
MONGODB_URI=your_mongodb_uri_here

# Paystack
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Pusher (realtime broadcast)
PUSHER_APP_ID="xxxxxxx"
PUSHER_KEY="xxxxxxxxxxxxxxxxxxxx"
PUSHER_SECRET=your_pusher_secret_here
PUSHER_CLUSTER="mt1"
NEXT_PUBLIC_PUSHER_KEY="xxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# Upstash QStash (external scheduler)
QSTASH_TOKEN=your_qstash_token_here
QSTASH_CURRENT_SIGNING_KEY="sig_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
QSTASH_NEXT_SIGNING_KEY="sig_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Game engine config (no hardcoded values in code)
GAME_TICK_INTERVAL_MS=1000
GAME_PREPARE_MS=5000
GAME_GROWTH_RATE=1.0718

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL="http://localhost:3000"
